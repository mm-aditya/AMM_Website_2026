---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Aditya Manikashetti — Director, Creative Director, Creative Technologist.',
  ogImage,
} = Astro.props;

const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);
const ogImageUrl = ogImage ? new URL(ogImage, base) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Set theme before first paint (no flash). Default is always light;
      // only an explicit prior toggle (saved) changes it. System pref is ignored.
      (() => {
        const t = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
      // Keep the choice across view-transition navigations.
      document.addEventListener('astro:after-swap', () => {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      });
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href="/fonts/satoshi-variable.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body>
    <slot />
    <button class="theme-toggle" type="button" aria-label="Toggle light or dark theme">
      <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2.5v2.5M12 19v2.5M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2.5 12h2.5M19 12h2.5M4.2 19.8l1.8-1.8M18 6l1.8-1.8"
        ></path>
      </svg>
      <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4 7 7 0 1 0 20 14.5z"></path>
      </svg>
    </button>
    <div class="cursor-blob" aria-hidden="true"></div>

    <script>
      function initThemeToggle() {
        const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
        if (!btn || btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
          const next =
            document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('theme', next);
        });
      }
      document.addEventListener('astro:page-load', initThemeToggle);
      initThemeToggle();
    </script>

    <script>
      // Cursor blob: lags slightly behind the pointer, squashes and stretches
      // along its direction of travel like a rubbery drop.
      let raf = 0;
      let listenersBound = false;
      let blob: HTMLElement | null = null;
      let tx = -100,
        ty = -100,
        x = -100,
        y = -100,
        seen = false;

      function initBlob() {
        cancelAnimationFrame(raf);
        blob = document.querySelector<HTMLElement>('.cursor-blob');
        if (!blob || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        if (seen) blob.classList.add('alive');

        if (!listenersBound) {
          listenersBound = true;
          document.addEventListener(
            'mousemove',
            (e) => {
              tx = e.clientX;
              ty = e.clientY;
              if (!seen) {
                seen = true;
                x = tx;
                y = ty;
                blob?.classList.add('alive');
              }
            },
            { passive: true }
          );
          document.addEventListener('mouseleave', () => blob?.classList.remove('alive'));
          document.addEventListener('mouseenter', () => seen && blob?.classList.add('alive'));
        }

        function tick() {
          const dx = tx - x;
          const dy = ty - y;
          x += dx * 0.4; /* snappier — tracks close to the real pointer */
          y += dy * 0.4;

          const speed = Math.hypot(dx, dy);
          const stretch = Math.min(speed * 0.01, 0.4);
          const angle = Math.atan2(dy, dx);

          if (blob) {
            blob.style.transform =
              `translate(${x - 9}px, ${y - 9}px) rotate(${angle}rad) ` +
              `scale(${1 + stretch}, ${1 / (1 + stretch)})`;
          }
          raf = requestAnimationFrame(tick);
        }
        raf = requestAnimationFrame(tick);
      }

      // astro:page-load may fire before this module registers its listener on a
      // fresh load, so also run immediately; initBlob is idempotent.
      document.addEventListener('astro:page-load', initBlob);
      initBlob();
    </script>
  </body>
</html>
