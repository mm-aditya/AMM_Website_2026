---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year
);

// Resolve hover-collage media (mixed images + video loops) from project folders.
const imgMods = import.meta.glob<ImageMetadata>(
  '../content/work/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' }
);
const vidMods = import.meta.glob<string>('../content/work/**/*.{mp4,webm}', {
  eager: true,
  query: '?url',
  import: 'default',
});

async function resolvePreviews(slug: string, names: string[]) {
  const out: { t: 'img' | 'vid'; src: string }[] = [];
  for (const name of names) {
    const key = `../content/work/${slug}/${name.replace(/^\.\//, '')}`;
    if (key in vidMods) {
      out.push({ t: 'vid', src: vidMods[key] });
    } else if (key in imgMods) {
      out.push({ t: 'img', src: (await getImage({ src: imgMods[key], width: 640 })).src });
    }
  }
  return out;
}

const rows = await Promise.all(
  projects.map(async (p) => {
    const slug = p.id.replace(/\/index$/, '');
    const names = p.data.previews.length
      ? p.data.previews
      : p.data.preview
        ? ['./preview.jpg']
        : [];
    return {
      slug,
      data: p.data,
      previews: await resolvePreviews(slug, names),
    };
  })
);

const year = new Date().getFullYear();
---

<BaseLayout title="Aditya Manikashetti">
  <main class="home">
    <header class="masthead">
      <h1 class="site-name">Aditya Manikashetti</h1>
      <p class="subtitle">Director, creative director, creative technologist</p>
      <p class="bio">
        I make commercials and short films, and build the tools and workflows that hold
        post-production together. <a href="mailto:aditya.manikashetti@gmail.com">Email me</a> about
        select projects.
      </p>
    </header>

    <section class="index" aria-label="Work">
      <h2 class="index-heading">Work</h2>
      <div class="index-scroll">
        {
          rows.map((r) => (
            <a
              class="index-row"
              href={`/work/${r.slug}/`}
              data-previews={JSON.stringify(r.previews)}
              data-slug={r.slug}
            >
              <span class="row-top">
                <span class="row-title" transition:name={`title-${r.slug}`}>
                  {r.data.title}
                </span>
                <span class="row-year">{r.data.year}</span>
              </span>
              <span class="row-sub">
                {r.data.summary} {r.data.role}.
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <footer class="home-footer">
      <span>Aditya Manikashetti</span>
      <span>© {year}</span>
    </footer>
  </main>

  <div class="preview-stage" aria-hidden="true"></div>

  <script>
    const bound = new WeakSet<Element>();

    function buildCollage(stage: HTMLElement, slug: string, items: { t: string; src: string }[]) {
      stage.innerHTML = '';
      const n = items.length;
      items.forEach((m, i) => {
        const el =
          m.t === 'vid' ? document.createElement('video') : document.createElement('img');
        if (el instanceof HTMLVideoElement) {
          el.muted = true;
          el.autoplay = true;
          el.loop = true;
          el.playsInline = true;
        } else {
          el.alt = '';
        }
        el.src = m.src;
        el.className = 'collage-item';

        // horizontal strip: no overlap, no rotation — items share the width
        // evenly with small gaps, each nudged by a small vertical offset
        const gap = 12;
        const w = Math.min(n > 1 ? 260 : 320, (stage.clientWidth - (n - 1) * gap) / n);
        const dy = n > 1 ? (i % 2 === 0 ? -1 : 1) * 16 : 0;

        el.style.width = `${w}px`;
        el.style.transform = `translateY(${dy}px)`;
        el.style.transitionDelay = `${i * 45}ms`;
        stage.appendChild(el);
      });
    }

    function initHoverPreview() {
      const stage = document.querySelector<HTMLElement>('.preview-stage');
      if (!stage || !window.matchMedia('(hover: hover)').matches) return;
      let current = '';

      document.querySelectorAll<HTMLAnchorElement>('.index-row').forEach((row) => {
        if (bound.has(row)) return;
        bound.add(row);

        row.addEventListener('mouseenter', () => {
          const items = JSON.parse(row.dataset.previews || '[]');
          const slug = row.dataset.slug || '';
          if (!items.length) {
            stage.classList.remove('visible');
            return;
          }
          if (current !== slug) {
            current = slug;
            buildCollage(stage, slug, items);
          }
          const rect = row.getBoundingClientRect();
          const yPos = Math.min(
            Math.max(rect.top + rect.height / 2, 180),
            window.innerHeight - 180
          );
          stage.style.top = `${yPos}px`;
          stage.classList.add('visible');
        });
        row.addEventListener('mouseleave', () => stage.classList.remove('visible'));
      });
    }

    // astro:page-load may fire before this module registers its listener on a
    // fresh load, so also run immediately; the WeakSet makes re-runs harmless.
    document.addEventListener('astro:page-load', initHoverPreview);
    initHoverPreview();
  </script>
</BaseLayout>
