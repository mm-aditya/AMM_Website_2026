---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year
);

const rows = await Promise.all(
  projects.map(async (p) => ({
    slug: p.id.replace(/\/index$/, ''),
    data: p.data,
    previewSrc: p.data.preview ? (await getImage({ src: p.data.preview, width: 720 })).src : null,
  }))
);

const year = new Date().getFullYear();
---

<BaseLayout title="Aditya Manikashetti">
  <main class="home">
    <header class="masthead">
      <h1 class="site-name">Aditya Manikashetti</h1>
      <p class="subtitle">Director, creative director, creative technologist</p>
      <p class="bio">
        I make commercials and short films, and build the tools and workflows that hold
        post-production together. <a href="mailto:krishna@penukonda.me">Email me</a> about
        select projects.
      </p>
    </header>

    <section class="index" aria-label="Work">
      <h2 class="index-heading">Work</h2>
      <div class="index-scroll">
        {
          rows.map((r) => (
            <a class="index-row" href={`/work/${r.slug}/`} data-preview={r.previewSrc}>
              <span class="row-top">
                <span class="row-title" transition:name={`title-${r.slug}`}>
                  {r.data.title}
                </span>
                <span class="row-year">{r.data.year}</span>
              </span>
              <span class="row-sub">
                {r.data.summary} {r.data.role}.
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <footer class="home-footer">
      <span>Aditya Manikashetti</span>
      <span>© {year}</span>
    </footer>
  </main>

  <div class="hover-preview" aria-hidden="true"><img alt="" /></div>

  <script>
    function initHoverPreview() {
      const box = document.querySelector('.hover-preview');
      const img = box?.querySelector('img');
      if (!box || !img || !window.matchMedia('(hover: hover)').matches) return;

      document.querySelectorAll<HTMLAnchorElement>('.index-row').forEach((row) => {
        row.addEventListener('mouseenter', () => {
          const src = row.dataset.preview;
          if (!src) {
            box.classList.remove('visible');
            return;
          }
          if (img.getAttribute('src') !== src) img.setAttribute('src', src);
          box.classList.add('visible');
        });
        row.addEventListener('mouseleave', () => box.classList.remove('visible'));
      });
    }

    document.addEventListener('astro:page-load', initHoverPreview);
  </script>
</BaseLayout>
