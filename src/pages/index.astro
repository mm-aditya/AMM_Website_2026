---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year
);

// Resolve hover-collage media (mixed images + video loops) from project folders.
const imgMods = import.meta.glob<ImageMetadata>(
  '../content/work/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' }
);
const vidMods = import.meta.glob<string>('../content/work/**/*.{mp4,webm}', {
  eager: true,
  query: '?url',
  import: 'default',
});

async function resolvePreviews(slug: string, names: string[]) {
  const out: { t: 'img' | 'vid'; src: string }[] = [];
  for (const name of names) {
    // External URL (e.g. Gumlet) — pass straight through, type by extension
    if (/^https?:\/\//.test(name)) {
      out.push({ t: /\.(mp4|webm)(\?|$)/i.test(name) ? 'vid' : 'img', src: name });
      continue;
    }
    // Local file committed in the project folder — optimized at build
    const key = `../content/work/${slug}/${name.replace(/^\.\//, '')}`;
    if (key in vidMods) {
      out.push({ t: 'vid', src: vidMods[key] });
    } else if (key in imgMods) {
      out.push({ t: 'img', src: (await getImage({ src: imgMods[key], width: 640 })).src });
    }
  }
  return out;
}

const rows = await Promise.all(
  projects.map(async (p) => {
    const slug = p.id.replace(/\/index$/, '');
    const names = p.data.previews.length
      ? p.data.previews
      : p.data.preview
        ? ['./preview.jpg']
        : [];
    return {
      slug,
      data: p.data,
      previews: await resolvePreviews(slug, names),
    };
  })
);

const year = new Date().getFullYear();
---

<BaseLayout title="Aditya Manikashetti">
  <main class="home">
    <header class="masthead">
      <h1 class="site-name">Aditya Manikashetti</h1>
      <p class="subtitle">
        <span class="role-rotator" aria-hidden="true">Director</span>
        <span class="sr-only">Director, creative director, creative technologist</span>
      </p>
      <p class="bio">
        I make commercials and short films, and build the tools and workflows that hold
        post-production together. <a href="mailto:aditya.manikashetti@gmail.com">Email me</a> about
        select projects.
      </p>
    </header>

    <section class="index" aria-label="Work">
      <h2 class="index-heading">Work</h2>
      <div class="index-scroll">
        {
          rows.map((r) => (
            <a
              class="index-row"
              href={`/work/${r.slug}/`}
              data-previews={JSON.stringify(r.previews)}
              data-slug={r.slug}
            >
              <span class="row-top">
                <span class="row-title">{r.data.title}</span>
                <span class="row-year">{r.data.year}</span>
              </span>
              <span class="row-sub">
                {r.data.summary} {r.data.role}.
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <footer class="home-footer">
      <span>Aditya Manikashetti</span>
      <span><span class="clock" aria-hidden="true">--:--:--</span> · © {year}</span>
    </footer>
  </main>

  <div class="preview-stage" aria-hidden="true"></div>

  <script>
    const bound = new WeakSet<Element>();

    function buildCollage(stage: HTMLElement, slug: string, items: { t: string; src: string }[]) {
      stage.innerHTML = '';
      const n = items.length;
      items.forEach((m, i) => {
        const el =
          m.t === 'vid' ? document.createElement('video') : document.createElement('img');
        if (el instanceof HTMLVideoElement) {
          el.muted = true;
          el.autoplay = true;
          el.loop = true;
          el.playsInline = true;
        } else {
          el.alt = '';
        }
        el.src = m.src;
        el.className = 'collage-item';

        // horizontal strip: no overlap, no rotation — items share the width
        // evenly with small gaps, each nudged by a small vertical offset
        const gap = 12;
        const w = Math.min(n > 1 ? 260 : 320, (stage.clientWidth - (n - 1) * gap) / n);
        const dy = n > 1 ? (i % 2 === 0 ? -1 : 1) * 16 : 0;

        el.style.width = `${w}px`;
        el.style.transform = `translateY(${dy}px)`;
        el.style.transitionDelay = `${i * 45}ms`;
        stage.appendChild(el);
      });
    }

    function initHoverPreview() {
      const stage = document.querySelector<HTMLElement>('.preview-stage');
      if (!stage || !window.matchMedia('(hover: hover)').matches) return;
      let current = '';

      document.querySelectorAll<HTMLAnchorElement>('.index-row').forEach((row) => {
        if (bound.has(row)) return;
        bound.add(row);

        row.addEventListener('mouseenter', () => {
          const items = JSON.parse(row.dataset.previews || '[]');
          const slug = row.dataset.slug || '';
          if (!items.length) {
            stage.classList.remove('visible');
            return;
          }
          if (current !== slug) {
            current = slug;
            buildCollage(stage, slug, items);
          }
          const rect = row.getBoundingClientRect();
          const yPos = Math.min(
            Math.max(rect.top + rect.height / 2, 180),
            window.innerHeight - 180
          );
          stage.style.top = `${yPos}px`;
          stage.classList.add('visible');
        });
        row.addEventListener('mouseleave', () => stage.classList.remove('visible'));
      });
    }

    // ---- mobile: continuous tiered fade tied to scroll ------------------------
    // No hover, no tap. Each row's brightness is a function of its distance from
    // the focus line, so the project nearest it is brightest and the rest tier
    // off smoothly as you scroll. Drives a per-row --f (0..1); CSS maps it to
    // opacity between --dim and 1.
    let mobileRaf = 0;

    function updateMobileFade() {
      const rows = document.querySelectorAll<HTMLElement>('.index-row');
      if (!window.matchMedia('(max-width: 1000px)').matches) {
        rows.forEach((r) => r.style.removeProperty('--f'));
        return;
      }
      const focusY = window.innerHeight * 0.4;
      const range = window.innerHeight * 0.6;
      rows.forEach((r) => {
        const rect = r.getBoundingClientRect();
        const center = rect.top + rect.height / 2;
        const f = Math.max(0, 1 - Math.abs(center - focusY) / range);
        r.style.setProperty('--f', (f * f).toFixed(3)); // squared = tighter tiers
      });
    }

    function onScrollFade() {
      cancelAnimationFrame(mobileRaf);
      mobileRaf = requestAnimationFrame(updateMobileFade);
    }

    // ---- masthead name: letters thicken near the cursor -----------------------
    // Rests at the site weight (550) and climbs toward ~760 as the pointer nears
    // each letter. Desktop / fine-pointer only.
    const NAME_BASE = 550;
    const NAME_MAX = 760;
    const NAME_RADIUS = 120;
    let nameSpans: HTMLElement[] = [];
    let nameCenters: { x: number; y: number }[] = [];

    function cacheNameCenters() {
      nameCenters = nameSpans.map((s) => {
        const r = s.getBoundingClientRect();
        return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
      });
    }

    function initNameWeight() {
      const name = document.querySelector<HTMLElement>('.site-name');
      if (!name || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      if (!name.dataset.split) {
        name.dataset.split = '1';
        const text = name.textContent || '';
        name.textContent = '';
        nameSpans = [];
        for (const ch of text) {
          const s = document.createElement('span');
          s.className = 'nch';
          s.textContent = ch;
          if (ch === ' ') s.style.whiteSpace = 'pre';
          name.appendChild(s);
          nameSpans.push(s);
        }
      }
      cacheNameCenters();
    }

    document.addEventListener(
      'mousemove',
      (e) => {
        if (!nameSpans.length) return;
        for (let i = 0; i < nameSpans.length; i++) {
          const c = nameCenters[i];
          if (!c) continue;
          const d = Math.hypot(e.clientX - c.x, e.clientY - c.y);
          const t = Math.max(0, 1 - d / NAME_RADIUS);
          const w = Math.round(NAME_BASE + (NAME_MAX - NAME_BASE) * t * t);
          nameSpans[i].style.fontVariationSettings = `'wght' ${w}`;
        }
      },
      { passive: true }
    );

    // ---- rotating role + live clock -------------------------------------------
    const ROLES = ['Director', 'Creative Director', 'Creative Technologist'];
    let roleTimer = 0;
    let clockTimer = 0;

    function initRoles() {
      const el = document.querySelector<HTMLElement>('.role-rotator');
      if (!el) return;
      clearInterval(roleTimer);
      let i = Math.max(0, ROLES.indexOf((el.textContent || '').trim()));
      roleTimer = window.setInterval(() => {
        el.style.opacity = '0';
        window.setTimeout(() => {
          i = (i + 1) % ROLES.length;
          el.textContent = ROLES[i];
          el.style.opacity = '1';
        }, 350);
      }, 2800);
    }

    function initClock() {
      const el = document.querySelector<HTMLElement>('.clock');
      if (!el) return;
      clearInterval(clockTimer);
      const update = () => {
        el.textContent = new Date().toLocaleTimeString([], {
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
        });
      };
      update();
      clockTimer = window.setInterval(update, 1000);
    }

    function initMasthead() {
      initNameWeight();
      initRoles();
      initClock();
    }

    document.addEventListener('astro:page-load', () => {
      initHoverPreview();
      updateMobileFade();
      initMasthead();
    });
    initHoverPreview();
    updateMobileFade();
    initMasthead();
    window.addEventListener('scroll', onScrollFade, { passive: true });
    window.addEventListener('resize', () => {
      onScrollFade();
      cacheNameCenters();
    });
  </script>
</BaseLayout>
