---
// DEV-ONLY weight specimen — delete before deploying (404s in prod via this guard).
if (import.meta.env.PROD) {
  return new Response(null, { status: 404 });
}
const WEIGHTS = [400, 450, 500, 550, 600, 700];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Satoshi weights — pick one</title>
    <style>
      @font-face {
        font-family: 'Satoshi Var';
        src: url('/fonts/satoshi-variable.woff2') format('woff2');
        font-weight: 300 900;
        font-style: normal;
        font-display: swap;
      }
      :root {
        --bg: #fafaf7;
        --ink: #45413a;
        --muted: #9c978c;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: 'Satoshi Var', sans-serif;
        font-size: 1rem;
        line-height: 1.35;
      }
      .intro {
        max-width: 640px;
        margin: 0;
        padding: 3rem 1.5rem 2rem 10vw;
        color: var(--muted);
      }
      section {
        padding: 2.5rem 1.5rem 3rem 10vw;
        border-top: 2px solid var(--ink);
      }
      .label {
        color: #b04a2f;
        margin: 0 0 2rem;
        font-variant-numeric: tabular-nums;
      }
      .mini { max-width: 640px; }
      .m-name { margin: 0; font-size: 1rem; }
      .m-sub { margin: 0.1rem 0 0; color: var(--muted); }
      .m-bio { margin: 1.4rem 0 0; max-width: 46ch; }
      .m-bio a { color: inherit; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
      .m-work { margin: 2.5rem 0 1.4rem; color: var(--muted); }
      .m-row { margin-bottom: 1.4rem; }
      .m-top { display: flex; align-items: baseline; justify-content: space-between; gap: 3rem; }
      .m-year { color: var(--muted); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
      .m-blurb { display: block; margin-top: 0.1rem; color: var(--muted); max-width: 42ch; }
    </style>
  </head>
  <body>
    <p class="intro">
      Same composition at six weights. Everything within each block uses the SAME single weight —
      hierarchy stays color-only. 400 is what the site has now; 700 was the old bold. The
      in-betweens come from the variable cut.
    </p>
    {
      WEIGHTS.map((w) => (
        <section style={`font-weight: ${w}`}>
          <p class="label">{w} {w === 400 ? '— current' : w === 500 ? '— Medium (the static cut)' : w === 700 ? '— the old bold, for reference' : ''}</p>
          <div class="mini">
            <h1 class="m-name" style={`font-weight: ${w}`}>Aditya Manikashetti</h1>
            <p class="m-sub">Director, creative director, creative technologist</p>
            <p class="m-bio">
              I make commercials and short films, and build the tools and workflows that hold
              post-production together. <a href="#">Email me</a> about select projects.
            </p>
            <p class="m-work">Work</p>
            <div class="m-row">
              <span class="m-top"><span>The Long Way Home</span><span class="m-year">2025</span></span>
              <span class="m-blurb">A short documentary following a seasonal migration route through the high desert. Director.</span>
            </div>
            <div class="m-row">
              <span class="m-top"><span>Shot Notes</span><span class="m-year">2025</span></span>
              <span class="m-blurb">A frame-accurate review and annotation tool that lives in the browser. Creative Technologist.</span>
            </div>
          </div>
        </section>
      ))
    }
  </body>
</html>
